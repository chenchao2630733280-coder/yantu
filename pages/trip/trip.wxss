.trip-page{min-height:100vh;background:var(--paper)}.hero{height:600rpx;color:white}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.1),rgba(0,0,0,.65))}.hero-nav{position:relative;display:flex;justify-content:space-between;align-items:center;padding:0 28rpx}.light{color:white}.hero-actions{letter-spacing:3rpx}.hero-copy{position:absolute;left:34rpx;right:34rpx;bottom:44rpx}.hero-copy .display{font-size:60rpx;margin:18rpx 0 8rpx}.sheet{position:relative;margin-top:-18rpx;border-radius:30rpx 30rpx 0 0;background:var(--paper);padding:28rpx}.stats{display:flex;background:white;border-radius:25rpx;padding:28rpx 8rpx}.stats view{flex:1;text-align:center;border-right:1rpx solid var(--line)}.stats view:last-child{border:0}.stats b{display:block;font-size:34rpx}.stats text{font-size:20rpx;color:var(--muted)}.route-band{height:150rpx;position:relative;display:flex;align-items:center;justify-content:space-around;margin:18rpx 0}.route-line{position:absolute;height:4rpx;background:#cbd4c8;left:12%;right:12%;top:60rpx}.route-stop{z-index:1;text-align:center}.route-stop i{display:block;width:20rpx;height:20rpx;border-radius:50%;background:var(--orange);border:6rpx solid white;margin:0 auto 13rpx}.route-stop text{font-size:22rpx}.confirm{padding:30rpx;margin-bottom:38rpx}.confirm .subtle{margin:12rpx 0 24rpx}.reject{height:70rpx;background:transparent;color:var(--muted);font-size:23rpx}.story-head{display:flex;align-items:flex-end;justify-content:space-between;margin:16rpx 0 24rpx}.memory-link{font-size:23rpx;color:var(--blue)}.day-list{display:flex;flex-direction:column;gap:18rpx}.day{display:flex;overflow:hidden}.day-no{width:122rpx;padding:25rpx 16rpx;background:#f7f8f5;text-align:center;flex:none}.day-no b,.day-no text{display:block}.day-no text{font-size:22rpx;margin-top:8rpx}.day-body{padding:24rpx;flex:1;min-width:0}.day-row{display:flex;justify-content:space-between}.day-row text{font-size:21rpx;color:var(--muted)}.thumbs{display:flex;margin-top:17rpx}.thumb{width:105rpx;height:72rpx;margin-right:7rpx;border-radius:10rpx}.map-button{margin-top:28rpx}
