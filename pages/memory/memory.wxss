.memory{background:#e9ebe6}.poster{overflow:hidden}.poster-head{padding:38rpx}.poster-head .display{margin:14rpx 0}.poster-photo{height:390rpx}.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rpx;background:var(--line);border-bottom:1rpx solid var(--line)}.stats-grid view{background:white;padding:28rpx 15rpx}.stats-grid b,.stats-grid text{display:block}.stats-grid b{font-size:30rpx;color:var(--blue)}.stats-grid text{font-size:19rpx;color:var(--muted);margin-top:5rpx}.memory-route,.memory-story{padding:34rpx}.memory-photos{display:flex;gap:10rpx;margin-top:20rpx}.memory-place{width:25%;font-size:18rpx}.memory-place>view{height:105rpx;border-radius:12rpx}.memory-place text{display:block;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.memory-story{padding-top:5rpx}.memory-story>text{display:block;font-family:"Songti SC",serif;line-height:1.8;margin-top:14rpx}.signature{text-align:center;color:var(--muted);font-size:19rpx;padding:10rpx 0 34rpx}.share{margin-top:25rpx}
