<view class="page"><view class="safe-top"></view><view class="nav"><view class="back" bindtap="back">‹</view><view class="nav-title">Day {{day}} <text class="subtle">7月19日 周六</text></view><view>•••</view></view><view class="filters"><view wx:for="{{periods}}" wx:key="*this" class="filter {{period===item?'active':''}}" data-value="{{item}}" bindtap="select">{{item}}</view></view><view class="timeline"><view wx:for="{{events}}" wx:key="id" class="event" data-id="{{item.id}}" bindtap="open"><view class="time">{{item.time}}</view><view class="rail"><view class="rail-point"></view></view><view class="photo-frame event-photo"><image class="photo-atlas tile-{{item.tile}}" src="/assets/kansai-atlas.png" mode="scaleToFill"/></view><view class="event-copy"><view class="event-title">{{item.title}}</view><view class="subtle">{{item.duration}}</view><view class="event-meta">▧ {{item.photos}} 张 <text class="pill">{{item.tag}}</text></view></view><view>•••</view></view><view wx:if="{{!events.length}}" class="empty">这段时间没有记忆事件</view></view><button class="add-note" bindtap="add">＋ 记下一句话</button></view>
