.nav-title .subtle{margin-left:10rpx}.filters{display:flex;background:white;border-radius:24rpx;padding:7rpx;margin:12rpx 0 32rpx}.filter{flex:1;text-align:center;padding:17rpx 0;color:var(--muted);font-size:23rpx;border-radius:18rpx}.filter.active{background:var(--ink);color:white}.timeline{padding-bottom:130rpx}.event{display:flex;align-items:flex-start;min-height:160rpx}.time{width:76rpx;font-size:22rpx;padding-top:5rpx}.rail{width:34rpx;align-self:stretch;position:relative}.rail:after{content:'';position:absolute;left:10rpx;top:21rpx;bottom:0;width:2rpx;background:#d9ddd6}.rail i{position:absolute;left:4rpx;top:5rpx;width:14rpx;height:14rpx;border-radius:50%;background:white;border:3rpx solid var(--ink);z-index:1}.event-photo{width:142rpx;height:116rpx;border-radius:18rpx;flex:none}.event-copy{flex:1;padding:2rpx 16rpx}.event-title{font-weight:700;font-size:27rpx}.event-meta{font-size:21rpx;color:var(--muted);margin-top:15rpx}.event-meta .pill{float:right}.add-note{position:fixed;right:30rpx;bottom:40rpx;background:var(--ink);color:white;height:76rpx;line-height:76rpx;padding:0 27rpx;border-radius:40rpx;font-size:24rpx}.empty{text-align:center;color:var(--muted);padding:100rpx 0}
