.event-page{padding-bottom:70rpx}.event-hero{display:flex;overflow:hidden;min-height:330rpx}.event-info{width:47%;padding:34rpx 12rpx 30rpx 30rpx;display:flex;flex-direction:column;gap:15rpx}.hero-photo{width:53%;min-height:330rpx}.location{font-size:22rpx;margin-top:auto}.photo-strip{display:flex;gap:9rpx;margin:20rpx 0;position:relative}.mini{width:160rpx;height:106rpx;border-radius:15rpx}.more{position:absolute;right:14rpx;top:25rpx;background:rgba(0,0,0,.72);color:white;padding:12rpx;border-radius:14rpx}.story{padding:30rpx;margin-bottom:20rpx}.story-text{font-family:"Songti SC",serif;font-size:29rpx;line-height:1.8;margin-top:14rpx}.user-memory{border-left:5rpx solid var(--orange);margin-top:25rpx;padding-left:20rpx;font-family:"Songti SC",serif}.user-memory text{display:block;color:var(--muted);font-family:sans-serif;font-size:20rpx;margin-top:8rpx}.note{padding:28rpx}.note-row{display:flex;justify-content:space-between;gap:20rpx}.small{font-size:28rpx}.edit{flex:none;background:#eef0ec;height:64rpx;line-height:64rpx;border-radius:20rpx;font-size:22rpx;padding:0 20rpx}textarea{width:100%;height:170rpx;background:#f4f5f2;padding:22rpx;border-radius:18rpx;font-size:25rpx}.note-actions{display:flex;justify-content:flex-end;margin-top:16rpx;gap:12rpx}.note-actions button{font-size:23rpx;height:65rpx;line-height:65rpx}.note-actions .save{background:var(--ink);color:white}.fact-actions{display:flex;gap:10rpx;margin-top:22rpx}.fact-actions button{flex:1;background:transparent;border:1rpx solid var(--line);font-size:21rpx;color:var(--muted);height:72rpx;line-height:72rpx;padding:0}
