<view class="page event-page"><view class="safe-top"></view><view class="nav"><view class="back" bindtap="back">‹</view><view class="nav-title">{{event.title}}</view><view bindtap="correct">•••</view></view><view class="event-hero card"><view class="event-info"><view class="eyebrow">{{event.time}} – {{event.endTime}}</view><view class="section-title">{{event.title}}</view><view class="subtle">7月19日 周六 · {{event.duration}}</view><view class="location">⌖ {{event.title}}</view></view><view class="photo-frame hero-photo" bindtap="preview"><image class="photo-atlas tile-{{event.tile}}" src="/assets/kansai-atlas.png" mode="scaleToFill"/></view></view><view class="photo-strip"><view wx:for="{{event.previewTiles}}" wx:key="*this" class="photo-frame mini"><image class="photo-atlas tile-{{item}}" src="/assets/kansai-atlas.png" mode="scaleToFill"/></view><view class="more">+{{event.photos-4}}</view></view><view class="story card"><view class="eyebrow">AI 故事片段</view><view class="story-text">{{event.story}}</view><view wx:if="{{event.note}}" class="user-memory">“{{event.note}}”<text>你留下的记忆</text></view></view><view class="note card"><view wx:if="{{!editing}}"><view class="note-row"><view><view class="section-title small">{{event.note?'补充的记忆':'照片之外，还记得什么？'}}</view><view class="subtle">{{event.note||'只写一句话，也能让这段故事更像你。'}}</view></view><button class="edit" bindtap="toggleEdit">{{event.note?'修改':'＋ 写一句'}}</button></view></view><view wx:else><textarea maxlength="100" value="{{note}}" bindinput="input" placeholder="比如：那天下雨，我们躲进一家很小的咖啡店。" auto-focus="{{true}}"/><view class="note-actions"><button bindtap="toggleEdit">取消</button><button class="save" bindtap="save">保存记忆</button></view></view></view><view class="fact-actions"><button bindtap="correct">⌾ 纠正事实</button><button bindtap="correct">⌁ 合并事件</button><button bindtap="correct">••• 更多</button></view><view wx:if="{{toast}}" class="toast">{{toast}}</view></view>
