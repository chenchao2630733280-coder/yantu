<view class="map-page"><map class="map" latitude="35.001" longitude="135.776" scale="12" markers="{{markers}}" bindmarkertap="mark" show-location="{{false}}"></map><view class="map-overlay"><view class="safe-top"></view><view class="map-nav"><view class="back bubble" bindtap="back">‹</view><view class="map-title">日本关西之旅<text>Day 2 · 京都</text></view><view class="bubble">⌖</view></view></view><view class="route-mini"><view wx:for="{{events}}" wx:key="id" class="route-dot {{selected.id===item.id?'on':''}}" data-id="{{item.id}}"><i></i><text>{{item.time}}</text></view></view><view class="map-card card" bindtap="open"><view><view class="eyebrow">{{selected.time}} · {{selected.photos}} 张照片</view><view class="section-title">{{selected.title}}</view><view class="subtle">{{selected.duration}}</view></view><view class="photo-frame map-thumb"><image class="photo-atlas tile-{{selected.tile}}" src="/assets/kansai-atlas.png" mode="scaleToFill"/></view><view class="chevron">›</view></view></view>
