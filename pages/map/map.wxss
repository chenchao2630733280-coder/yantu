.map-page{height:100vh;position:relative}.map{width:100%;height:100%}.map-overlay{position:absolute;left:0;right:0;top:0;background:linear-gradient(#f4f5f2,rgba(244,245,242,0));padding:0 24rpx 60rpx}.map-nav{display:flex;align-items:center;justify-content:space-between}.bubble{background:white;width:70rpx;height:70rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 24rpx rgba(0,0,0,.08)}.map-title{text-align:center;font-weight:700}.map-title text{display:block;color:var(--muted);font-size:20rpx;font-weight:400}.route-mini{position:absolute;left:28rpx;right:28rpx;bottom:245rpx;background:rgba(255,255,255,.94);padding:18rpx 22rpx;border-radius:24rpx;display:flex;justify-content:space-between}.route-dot{font-size:19rpx;color:var(--muted);text-align:center}.route-dot i{display:block;width:12rpx;height:12rpx;border-radius:50%;background:#adb2aa;margin:0 auto 5rpx}.route-dot.on i{background:var(--orange);transform:scale(1.5)}.map-card{position:absolute;left:28rpx;right:28rpx;bottom:40rpx;display:flex;align-items:center;padding:22rpx}.map-card>view:first-child{flex:1}.map-thumb{width:150rpx;height:120rpx;border-radius:18rpx}.chevron{font-size:40rpx;padding-left:14rpx}
