.nav{height:150rpx}.display{font-size:48rpx}.year-group{margin-top:40rpx}.year{font-family:"Songti SC",serif;font-size:54rpx;font-weight:700;margin-bottom:18rpx}.year-rail{position:relative;padding-left:28rpx}.line{position:absolute;left:7rpx;top:15rpx;bottom:-40rpx;width:2rpx;background:#d5d9d2}.timeline-trip{display:flex;padding:16rpx;margin-bottom:18rpx;position:relative}.timeline-trip>i{position:absolute;left:-28rpx;top:45rpx;width:15rpx;height:15rpx;border-radius:50%;background:var(--orange);border:5rpx solid var(--paper)}.timeline-photo{width:165rpx;height:138rpx;border-radius:18rpx;flex:none}.timeline-copy{padding:8rpx 18rpx;display:flex;flex-direction:column;gap:7rpx;min-width:0}.timeline-copy text{font-size:20rpx;color:var(--muted)}.timeline-copy view{font-size:21rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
