.home { padding-bottom: 32rpx; }.nav{height:132rpx}.brand{font-size:48rpx}.brand-line{font-size:22rpx;color:var(--muted);margin-top:6rpx}.intro{display:flex;justify-content:space-between;align-items:flex-end;margin:42rpx 0 28rpx}.scan{font-size:24rpx;line-height:64rpx;height:64rpx;padding:0 24rpx;border-radius:20rpx;background:var(--ink);color:white}.privacy{display:flex;gap:18rpx;padding:24rpx;border-radius:22rpx;background:#edf3eb;margin-bottom:26rpx;font-size:25rpx}.privacy-dot{color:#6d8a53;font-size:18rpx;margin-top:7rpx}.trip-list{display:flex;flex-direction:column;gap:20rpx}.trip-card{display:flex;align-items:center;padding:16rpx;min-height:174rpx}.cover{width:174rpx;height:142rpx;border-radius:20rpx;flex:none}.trip-copy{padding-left:22rpx;min-width:0;flex:1}.new-label{color:var(--orange);font-size:20rpx;margin-bottom:4rpx}.trip-title{font-size:29rpx;font-weight:700}.trip-date,.trip-meta,.trip-route{font-size:21rpx;color:var(--muted);margin-top:6rpx}.chevron{font-size:44rpx;padding:12rpx;color:#343833}
